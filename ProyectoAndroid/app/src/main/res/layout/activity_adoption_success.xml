<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootSuccess"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_fondo"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/contenedorSuccess"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:background="@drawable/bg_header_purple"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/espacio_grande">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_avatar_circle"
                android:contentDescription="@string/adoption_success_title"
                android:padding="14dp"
                android:src="@drawable/ic_check_success" />

            <TextView
                android:id="@+id/txtTituloSuccess"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_medio"
                android:gravity="center"
                android:text="@string/adoption_success_title"
                style="@style/TextScreenTitle" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.AdoptaPet.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/espacio_medio"
            android:layout_marginTop="-28dp"
            android:layout_marginEnd="@dimen/espacio_medio"
            android:layout_marginBottom="@dimen/espacio_grande">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="@dimen/espacio_grande">

                <TextView
                    android:id="@+id/txtMensajeSuccess"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/adoption_success_message"
                    android:textColor="@color/color_texto_secundario"
                    android:textSize="16sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_grande"
                    android:background="@drawable/bg_chip_purple"
                    android:orientation="vertical"
                    android:padding="@dimen/espacio_medio">

                    <TextView
                        android:id="@+id/txtMascotaSuccess"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/sample_success_pet"
                        android:textColor="@color/color_texto"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtEstadoSuccess"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacio_pequeno"
                        android:gravity="center"
                        android:text="@string/adoption_success_status"
                        android:textColor="@color/color_principal"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVolverInicio"
                    style="@style/Widget.AdoptaPet.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="@dimen/espacio_grande"
                    android:text="@string/adoption_success_back" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVerSolicitudes"
                    style="@style/Widget.AdoptaPet.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="@dimen/espacio_pequeno"
                    android:text="@string/adoption_success_requests"
                    app:strokeColor="@color/color_principal" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
