<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_fondo">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollFormulario"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_header_purple"
                android:orientation="vertical"
                android:paddingStart="@dimen/espacio_medio"
                android:paddingTop="@dimen/espacio_grande"
                android:paddingEnd="@dimen/espacio_medio"
                android:paddingBottom="@dimen/espacio_grande">

                <com.google.android.material.appbar.MaterialToolbar
                    android:id="@+id/toolbarFormulario"
                    style="@style/Widget.AdoptaPet.Toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    app:navigationIcon="@android:drawable/ic_menu_revert"
                    app:title="@string/adoption_form_title" />

                <TextView
                    android:id="@+id/tvMascotaFormulario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_pequeno"
                    android:text="@string/sample_adoption_form_pet"
                    style="@style/TextScreenTitle" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/adoption_form_subtitle"
                    style="@style/TextScreenSubtitle" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.AdoptaPet.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/espacio_medio"
                android:layout_marginTop="-24dp"
                android:layout_marginEnd="@dimen/espacio_medio"
                android:layout_marginBottom="@dimen/espacio_grande">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/espacio_medio">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/adoption_form_home_section"
                        style="@style/TextSectionTitle" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.AdoptaPet.TextInput.Dropdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacio_pequeno"
                        android:hint="@string/adoption_form_reason">

                        <AutoCompleteTextView
                            android:id="@+id/autoCompleteMotivo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/adoption_form_reason"
                            android:inputType="none"
                            android:popupBackground="@color/white"
                            android:textColor="@color/color_texto" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.AdoptaPet.TextInput.Dropdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacio_pequeno"
                        android:hint="@string/adoption_form_housing">

                        <AutoCompleteTextView
                            android:id="@+id/autoCompleteVivienda"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/adoption_form_housing"
                            android:inputType="none"
                            android:popupBackground="@color/white"
                            android:textColor="@color/color_texto" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.AdoptaPet.TextInput.Dropdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacio_pequeno"
                        android:hint="@string/adoption_form_experience">

                        <AutoCompleteTextView
                            android:id="@+id/autoCompleteExperiencia"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/adoption_form_experience"
                            android:inputType="none"
                            android:popupBackground="@color/white"
                            android:textColor="@color/color_texto" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.AdoptaPet.TextInput.Dropdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacio_pequeno"
                        android:hint="@string/adoption_form_other_pets">

                        <AutoCompleteTextView
                            android:id="@+id/autoCompleteOtrasMascotas"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/adoption_form_other_pets"
                            android:inputType="none"
                            android:popupBackground="@color/white"
                            android:textColor="@color/color_texto" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.AdoptaPet.TextInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacio_pequeno"
                        android:hint="@string/adoption_form_people">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtCantidadPersonas"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:textColor="@color/color_texto" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.AdoptaPet.TextInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacio_medio"
                        android:hint="@string/adoption_form_comments">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtMotivo"
                            android:layout_width="match_parent"
                            android:layout_height="120dp"
                            android:gravity="top"
                            android:inputType="textMultiLine"
                            android:textColor="@color/color_texto" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacio_medio"
                        android:text="@string/adoption_form_docs_section"
                        style="@style/TextSectionTitle" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnArchivoDni"
                        style="@style/Widget.AdoptaPet.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="@dimen/espacio_pequeno"
                        android:text="@string/adoption_form_attach_dni" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnArchivoDomicilio"
                        style="@style/Widget.AdoptaPet.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="@dimen/espacio_pequeno"
                        android:text="@string/adoption_form_attach_address" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEnviarSolicitud"
                        style="@style/Widget.AdoptaPet.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="@dimen/espacio_medio"
                        android:text="@string/adoption_form_send" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
