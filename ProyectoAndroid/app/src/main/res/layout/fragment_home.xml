<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_fondo">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_purple"
            android:orientation="vertical"
            android:paddingStart="@dimen/espacio_medio"
            android:paddingTop="@dimen/espacio_grande"
            android:paddingEnd="@dimen/espacio_medio"
            android:paddingBottom="@dimen/espacio_grande">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/home_title"
                style="@style/TextScreenTitle" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/home_subtitle"
                style="@style/TextScreenSubtitle" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutBuscar"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_medio"
                app:boxBackgroundColor="@color/white"
                app:boxCornerRadiusBottomEnd="18dp"
                app:boxCornerRadiusBottomStart="18dp"
                app:boxCornerRadiusTopEnd="18dp"
                app:boxCornerRadiusTopStart="18dp"
                app:boxStrokeColor="@color/white"
                app:hintEnabled="false"
                app:startIconDrawable="@android:drawable/ic_menu_search">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtBuscar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/search_title"
                    android:textColor="@color/color_texto"
                    android:textColorHint="@color/color_texto_secundario" />

            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_medio"
            android:paddingStart="@dimen/espacio_medio"
            android:paddingEnd="@dimen/espacio_medio"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTodas"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:checkable="true"
                    android:checked="true"
                    android:text="@string/btn_all"
                    android:textAllCaps="false"
                    android:textColor="@color/filter_button_text"
                    app:backgroundTint="@color/filter_button_background"
                    app:cornerRadius="20dp"
                    app:strokeColor="@color/filter_button_stroke" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPerros"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginStart="8dp"
                    android:checkable="true"
                    android:text="@string/btn_dogs"
                    android:textAllCaps="false"
                    android:textColor="@color/filter_button_text"
                    app:backgroundTint="@color/filter_button_background"
                    app:cornerRadius="20dp"
                    app:strokeColor="@color/filter_button_stroke" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGatos"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginStart="8dp"
                    android:checkable="true"
                    android:text="@string/btn_cats"
                    android:textAllCaps="false"
                    android:textColor="@color/filter_button_text"
                    app:backgroundTint="@color/filter_button_background"
                    app:cornerRadius="20dp"
                    app:strokeColor="@color/filter_button_stroke" />

            </LinearLayout>

        </HorizontalScrollView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/espacio_medio"
            android:layout_marginTop="@dimen/espacio_medio"
            android:layout_marginEnd="@dimen/espacio_medio"
            android:text="@string/home_pets_section"
            android:textColor="@color/color_texto"
            android:textSize="20sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMascotas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/espacio_medio"
            android:layout_marginTop="@dimen/espacio_medio"
            android:layout_marginEnd="@dimen/espacio_medio"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            android:paddingBottom="@dimen/espacio_medio" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
