<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_fondo">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_purple"
            android:orientation="vertical"
            android:paddingStart="@dimen/espacio_medio"
            android:paddingTop="@dimen/espacio_grande"
            android:paddingEnd="@dimen/espacio_medio"
            android:paddingBottom="@dimen/espacio_grande">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbarDetalleSolicitud"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:minHeight="48dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                app:navigationIcon="@android:drawable/ic_menu_revert"
                app:navigationIconTint="@color/white"
                app:title="@string/request_detail_title"
                app:titleTextColor="@color/white" />

            <TextView
                android:id="@+id/txtMascotaSolicitud"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_pequeno"
                android:text="@string/sample_request_detail_pet"
                android:textColor="@color/white"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtCodigoSolicitud"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/sample_request_detail_code"
                android:textColor="@color/color_principal_claro"
                android:textSize="15sp" />

        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/espacio_medio">

                <TextView
                    android:id="@+id/txtEstadoSolicitud"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_purple"
                    android:paddingStart="14dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="8dp"
                    android:text="@string/sample_request_detail_status"
                    android:textColor="@color/color_principal"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.AdoptaPet.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_medio">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/espacio_medio">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/request_detail_status"
                            style="@style/TextCardTitle" />

                        <TextView
                            android:id="@+id/txtMensajeEstado"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/espacio_pequeno"
                            android:text="@string/sample_request_detail_message"
                            android:textColor="@color/color_texto_secundario"
                            android:textSize="16sp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardProgramacion"
                    style="@style/Widget.AdoptaPet.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_medio">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/espacio_medio">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/request_detail_delivery"
                            style="@style/TextCardTitle" />

                        <TextView
                            android:id="@+id/txtFechaEntrega"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/espacio_pequeno"
                            android:text="@string/sample_request_detail_date"
                            android:textColor="@color/color_texto_secundario"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/txtHoraEntrega"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/sample_request_detail_schedule"
                            android:textColor="@color/color_texto_secundario"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/txtLimiteRecojo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/sample_request_detail_limit"
                            android:textColor="@color/color_texto_secundario"
                            android:textSize="16sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/espacio_medio"
                            android:background="@drawable/bg_chip_purple"
                            android:padding="@dimen/espacio_pequeno"
                            android:text="@string/request_detail_delivery_hint"
                            android:textColor="@color/color_principal"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
