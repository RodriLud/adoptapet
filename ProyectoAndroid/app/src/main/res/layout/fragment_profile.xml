<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_fondo">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:background="@drawable/bg_header_purple"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/espacio_grande">

            <TextView
                android:id="@+id/txtInicialPerfil"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:background="@drawable/bg_avatar_circle"
                android:gravity="center"
                android:text="@string/sample_profile_initials"
                android:textColor="@color/color_principal"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtNombrePerfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_medio"
                android:gravity="center"
                android:text="@string/sample_profile_user"
                android:textColor="@color/white"
                android:textSize="25sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtCorreoPerfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="@string/sample_profile_email"
                android:textColor="@color/color_principal_claro"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/espacio_medio"
            android:layout_marginTop="-30dp"
            android:layout_marginEnd="@dimen/espacio_medio"
            android:background="@drawable/bg_card_soft"
            android:elevation="6dp"
            android:orientation="horizontal"
            android:padding="@dimen/espacio_medio">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_role_label"
                    android:textColor="@color/color_texto_secundario"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/txtRolPerfil"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/sample_profile_role"
                    android:textColor="@color/color_principal"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="42dp"
                android:background="@color/color_borde" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_account_label"
                    android:textColor="@color/color_texto_secundario"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/profile_account_active"
                    android:textColor="@color/color_verde"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="42dp"
                android:background="@color/color_borde" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_app_label"
                    android:textColor="@color/color_texto_secundario"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/sample_profile_app"
                    android:textColor="@color/color_principal"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/espacio_medio"
            android:background="@drawable/bg_card_soft"
            android:elevation="4dp"
            android:orientation="vertical"
            android:padding="@dimen/espacio_medio">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/profile_info_section"
                android:textColor="@color/color_texto"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtDniPerfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_medio"
                android:text="@string/sample_profile_dni"
                android:textColor="@color/color_texto_secundario"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/txtTelefonoPerfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_pequeno"
                android:text="@string/sample_profile_phone"
                android:textColor="@color/color_texto_secundario"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/txtDireccionPerfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_pequeno"
                android:text="@string/sample_profile_address"
                android:textColor="@color/color_texto_secundario"
                android:textSize="15sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCerrarSesion"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginStart="@dimen/espacio_medio"
            android:layout_marginEnd="@dimen/espacio_medio"
            android:layout_marginBottom="@dimen/espacio_grande"
            android:text="@string/btn_close"
            android:textAllCaps="false"
            android:textColor="@color/color_principal"
            android:textStyle="bold"
            app:cornerRadius="14dp"
            app:strokeColor="@color/color_principal"
            app:strokeWidth="1dp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
