# ==================== Auto Detect & Default ====================
* text=auto

# ==================== Line Ending Handling ====================
# Windows shell scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.com text eol=crlf
*.exe text eol=crlf

# Unix shell scripts
*.sh text eol=lf
*.bash text eol=lf
gradlew text eol=lf

# Maven & Gradle
mvnw text eol=lf
mvnw.cmd text eol=crlf
gradle-wrapper.jar binary

# ==================== Configuration Files ====================
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.gradle text eol=lf
*.gradle.kts text eol=lf
*.editorconfig text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.prettierrc text eol=lf
.eslintrc* text eol=lf
.env* text eol=lf

# ==================== Source Code ====================
